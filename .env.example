DATABASE_URL=postgresql://user:password@host:5432/mintbot
# combined keeps the existing single-service deployment. For the V2 two-service
# layout use web on the dashboard service and worker on the execution service.
MINTBOT_EXECUTION_ROLE=combined
VAULT_PASSPHRASE=replace-with-at-least-32-random-characters
APP_ACCESS_USER=mintbot
APP_ACCESS_PASSWORD=replace-with-a-strong-browser-password
SUPPORT_ADMIN_TOKEN=replace-with-a-separate-random-admin-token
# Optional separate password for wallet/task deletion and signing-key replacement.
# If blank, APP_ACCESS_PASSWORD is used for these fresh confirmations.
ADMIN_ACTION_PASSWORD=
# Optional: use this instead of APP_ACCESS_PASSWORD. Avoid unless your IP is stable.
# ALLOWED_IPS=203.0.113.10
ALCHEMY_API_KEY=
# Strongly recommended for OpenSea signed-presale eligibility and mint payloads.
# Without it, the server requests an in-memory seven-day instant key. Never expose either key to the browser.
OPENSEA_API_KEY=
# Optional comma-separated provider endpoints; with Alchemy this gives Robinhood RPC failover.
ROBINHOOD_RPC_URLS=
# Preferred named provider endpoints. These appear separately in launch telemetry.
ROBINHOOD_QUICKNODE_URL=
ROBINHOOD_CHAINSTACK_URL=
ROBINHOOD_DRPC_URL=
# WebSocket priority is Alchemy first, QuickNode first fallback, then additional routes.
# Keep QuickNode configured so an Alchemy quota cannot blind launches.
ROBINHOOD_WS_URLS=
ROBINHOOD_WS_URL=
ROBINHOOD_QUICKNODE_WS_URL=
ROBINHOOD_CHAINSTACK_WS_URL=
ROBINHOOD_DRPC_WS_URL=
# Optional comma-separated read/broadcast routes for every supported chain.
ETHEREUM_RPC_URLS=
POLYGON_RPC_URLS=
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URLS=
BASE_RPC_URLS=
BNB_RPC_URLS=
AVALANCHE_RPC_URLS=
# Optional override; official mainnet sequencer is used by default for direct writes.
ROBINHOOD_SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com
# Latency engine tuning. Defaults are 60s arm and 5s final revalidation.
MINT_ARM_LEAD_MS=300000
MINT_REVALIDATE_LEAD_MS=5000
DISCORD_WEBHOOK_URL=
# Keep false until testnet verification passes.
ENABLE_LIVE_TRANSACTIONS=false
# Required only if ENABLE_LIVE_TRANSACTIONS=true.
LIVE_TRANSACTIONS_CONFIRMED=
